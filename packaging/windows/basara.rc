#include <winuser.h>
#include <winver.h>

1 ICON "icons/basara4.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "basara.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,2,0
PRODUCTVERSION  1,0,2,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Sengoku Basara 4 Sumeragi"
            VALUE "FileVersion",      "1.0.2.0"
            VALUE "InternalName",     "basara_pc"
            VALUE "OriginalFilename", "basara_pc.exe"
            VALUE "ProductName",      "Sengoku Basara 4 Sumeragi"
            VALUE "ProductVersion",   "1.0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
